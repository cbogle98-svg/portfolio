---
// Digital business card. One URL for everything: Messenger links, NFC tags and the QR code
// all point to https://bosqueworks.com/card. "Save my contact" serves /cody.vcf.
import Layout from '../layouts/Layout.astro';
import config from '../data/config.json';

const phoneDisplay = '(254) 277-2131';
---

<Layout
  title="Cody Bogle · Bosque Works LLC"
  description="Websites for Local Businesses. Veteran-owned, Stephenville, TX. Tap to save my contact, call, or text."
  ogImage="https://bosqueworks.com/card/og.png"
>
  <main class="card-page">
    <div class="card">
      <img class="logo" src="/brand/logo-reversed.svg" alt="Bosque Works" width="320" height="72" />

      <section class="who">
        <h1>{config.owner.name}</h1>
        <p class="role">Owner, {config.owner.businessLegalName}</p>
        <p class="tagline">Websites for Local Businesses</p>
        <p class="cred">★ Veteran-owned · {config.owner.location}</p>
      </section>

      <nav class="actions" aria-label="Contact Cody">
        <a class="btn primary" href="/cody.vcf" download="Cody Bogle.vcf">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="4"/><path d="M2 21c0-4 3-6 7-6s7 2 7 6M19 8v6M16 11h6"/></svg>
          Save my contact
        </a>
        <a class="btn" href={`tel:${config.owner.phone}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h4l2 5-3 2a12 12 0 0 0 6 6l2-3 5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg>
          Call {phoneDisplay}
        </a>
        <a class="btn" href={`sms:${config.owner.phone}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg>
          Text me
        </a>
        <a class="btn" href={`mailto:${config.owner.email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          {config.owner.email}
        </a>
        <a class="btn" href="/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>
          See my work
        </a>
      </nav>

      <section class="share">
        <img src="/card/qr.svg" alt="QR code for bosqueworks.com/card" width="160" height="160" />
        <p>Scan to save my info</p>
      </section>
    </div>
  </main>
</Layout>

<style>
  :global(body) {
    background: #1C1917;
  }
  .card-page {
    min-height: 100vh;
    background: #1C1917;
    color: #F5F5F4;
    display: flex;
    justify-content: center;
    padding: 40px 16px 48px;
    box-sizing: border-box;
  }
  .card {
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .logo {
    width: 240px;
    height: auto;
  }
  .who h1 {
    margin: 0;
    color: #F5F5F4;
    font-weight: 600;
    font-size: 40px;
    line-height: 1.1;
  }
  .who p {
    margin: 8px 0 0;
  }
  .role {
    color: #A8A29E;
    font-size: 17px;
  }
  .tagline {
    color: #F5F5F4;
    font-size: 17px;
    line-height: 1.4;
  }
  .cred {
    color: #FCD34D;
    font-size: 14px;
    font-weight: 700;
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .btn {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 0 16px;
    border-radius: 10px;
    background: #292524;
    color: #F5F5F4;
    font-size: 17px;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .btn:hover,
  .btn:focus-visible {
    background: #44403C;
  }
  .btn svg {
    width: 22px;
    height: 22px;
    flex: none;
    fill: none;
    stroke: #D97706;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .btn.primary {
    justify-content: center;
    background: #D97706;
    color: #1C1917;
    font-weight: 700;
  }
  .btn.primary:hover,
  .btn.primary:focus-visible {
    background: #FCD34D;
  }
  .btn.primary svg {
    stroke: #1C1917;
  }
  .share {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
  }
  .share img {
    background: #fff;
    border-radius: 12px;
    padding: 10px;
  }
  .share p {
    margin: 0;
    color: #A8A29E;
    font-size: 14px;
  }
</style>
