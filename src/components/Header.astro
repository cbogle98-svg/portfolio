---
import config from '../data/config.json';
---

<header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-xl border-b"
  style="background:rgba(28,25,23,0.95);border-color:rgba(231,229,228,0.08)">
  <div class="max-w-6xl mx-auto px-7 py-4 flex items-center justify-between">
    <a href="#" class="flex items-center gap-3 no-underline" aria-label={`${config.owner.businessName} home`}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 72" class="h-9 w-auto">
        <line x1="8" y1="56" x2="52" y2="56" stroke="#FAFAF9" stroke-width="2"/>
        <polyline points="8,56 8,22 28,38 48,22 48,56" fill="none" stroke="#FAFAF9" stroke-width="2" stroke-linejoin="round"/>
        <circle cx="28" cy="16" r="6" fill="#D97706"/>
        <text x="68" y="36" font-family="Arial, Helvetica, sans-serif" font-size="26" font-weight="300" fill="#FAFAF9" letter-spacing="1">BOSQUE</text>
        <line x1="68" y1="43" x2="310" y2="43" stroke="#D97706" stroke-width="1.25"/>
        <text x="68" y="58" font-family="Arial, Helvetica, sans-serif" font-size="12" font-weight="500" fill="#FCD34D" letter-spacing="5">WORKS</text>
      </svg>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium" style="color:#A8A29E">
      <a href="#services" class="hover:text-white transition">Services</a>
      <a href="#portfolio" class="hover:text-white transition">Portfolio</a>
      <a href="#pricing" class="hover:text-white transition">Pricing</a>
      <a href="#hosting" class="hover:text-white transition">Hosting</a>
      <a href="#faq" class="hover:text-white transition">FAQ</a>
    </nav>
    <a
      href="#contact"
      class="px-5 py-2.5 rounded-lg font-semibold text-xs text-white transition hover:-translate-y-0.5 hover:shadow-lg"
      style="background:var(--accent);letter-spacing:1px"
    >
      Get a Free Quote
    </a>
  </div>
</header>
