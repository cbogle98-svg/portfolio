---
import config from '../data/config.json';

const formatPrice = (n: number) => n.toLocaleString('en-US');
---

<section id="pricing" class="py-32" style="background:#FAFAF9">
  <div class="max-w-6xl mx-auto px-7">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="text-xs uppercase tracking-[0.3em] font-medium mb-3" style="color:#78350F">
        {config.pricing.eyebrow}
      </div>
      <h2 class="text-4xl md:text-5xl font-semibold mb-4 leading-[1.1] tracking-tight" style="color:#1C1917">
        {config.pricing.headline1}<br />{config.pricing.headline2}
      </h2>
      <p class="text-base leading-relaxed text-slate-500">
        {config.pricing.subhead}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 items-stretch">
      {config.pricing.tiers.map(tier => (
        <div class={`bg-white border rounded-2xl p-10 flex flex-col transition relative ${tier.featured ? 'border-2 scale-[1.03]' : 'border-slate-200 hover:-translate-y-1.5 hover:shadow-2xl'}`}
          style={tier.featured ? 'border-color:var(--accent);box-shadow:0 20px 60px rgba(217,119,6,0.15)' : ''}>
          {tier.featured && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full text-[11px] font-bold uppercase tracking-wider text-white"
              style="background:var(--accent)">
              {tier.badge}
            </div>
          )}
          <div class="text-xs uppercase tracking-widest font-semibold text-slate-500 mb-2">
            {tier.name}
          </div>
          <div class="flex items-baseline gap-1.5 mb-1">
            <span class="text-2xl font-bold text-slate-800">$</span>
            <span class="text-5xl font-extrabold text-slate-900 leading-none tracking-tight"
              style="font-family:var(--font-heading)">
              {formatPrice(tier.price)}
            </span>
          </div>
          <div class="text-xs uppercase tracking-wider text-slate-400 font-medium mb-3">
            one-time build cost
          </div>
          <div class="flex items-baseline gap-2 mb-4 pb-3 border-b border-slate-100">
            <span class="text-sm font-bold" style="color:var(--accent)">+ ${config.pricing.retainerMonthly}/mo</span>
            <span class="text-xs text-slate-500">ongoing · hosting &amp; support</span>
          </div>
          <p class="text-sm text-slate-500 mb-6 leading-relaxed">{tier.description}</p>

          <div class="h-px bg-slate-200 mb-6"></div>
          <ul class="flex flex-col gap-3 mb-8 flex-1">
            {tier.features.map(feature => (
              <li class="flex items-start gap-2.5 text-sm leading-snug text-slate-600">
                <span class="font-bold text-base flex-shrink-0" style="color:var(--accent)">✓</span>
                {feature}
              </li>
            ))}
          </ul>
          <a
            href="#contact"
            class={`block text-center px-6 py-3.5 rounded-lg font-bold text-sm transition hover:-translate-y-0.5 ${tier.featured ? 'text-white' : 'bg-slate-100 text-slate-800 border border-slate-200 hover:bg-slate-200'}`}
            style={tier.featured ? 'background:var(--accent)' : ''}
          >
            Get Started
          </a>
        </div>
      ))}
    </div>

    <p class="text-center mt-12 text-sm text-slate-500 max-w-3xl mx-auto">
      <strong>Build cost is a one-time fee. The ${config.pricing.retainerMonthly}/mo starts when your site goes live</strong> and covers managed hosting, uptime monitoring, content updates, security patches, and a monthly traffic report. Cancel anytime. &nbsp;|&nbsp;
      <a href="#contact" class="font-semibold" style="color:var(--accent)">Have something custom? Let's talk →</a>
    </p>
  </div>
</section>
