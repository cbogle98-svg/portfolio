---
import config from '../data/config.json';

const formatPrice = (n: number) => n.toLocaleString('en-US');
---

<section id="pricing" class="py-32" style="background:#F8FAFC">
  <div class="max-w-6xl mx-auto px-7">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="text-xs uppercase tracking-[0.3em] font-bold mb-3" style="color:var(--accent)">
        {config.pricing.eyebrow}
      </div>
      <h2 class="text-4xl md:text-5xl font-extrabold mb-4 text-slate-900 leading-[1.1] tracking-tight">
        {config.pricing.headline1}<br />{config.pricing.headline2}
      </h2>
      <p class="text-base leading-relaxed text-slate-500">
        {config.pricing.subhead}
      </p>
    </div>

    <div class="text-center mb-12">
      <div class="inline-flex items-center bg-white border border-slate-200 rounded-full p-1.5 shadow-sm" id="retainer-toggle">
        <button type="button" class="px-6 py-3 rounded-full text-sm font-semibold transition flex items-center gap-2 text-white" data-mode="onetime"
          style="background:var(--accent);box-shadow:0 4px 14px rgba(59,130,246,0.3)">
          One-Time Build
        </button>
        <button type="button" class="px-6 py-3 rounded-full text-sm font-semibold transition flex items-center gap-2 text-slate-500" data-mode="retainer">
          With Monthly Retainer
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider"
            style="background:rgba(245,158,11,0.15);color:var(--warm)">Save ${config.pricing.retainerSavings}</span>
        </button>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6 items-stretch">
      {config.pricing.tiers.map(tier => (
        <div class={`bg-white border rounded-2xl p-10 flex flex-col transition relative ${tier.featured ? 'border-2 scale-[1.03]' : 'border-slate-200 hover:-translate-y-1.5 hover:shadow-2xl'}`}
          style={tier.featured ? 'border-color:var(--accent);box-shadow:0 20px 60px rgba(59,130,246,0.12)' : ''}>
          {tier.featured && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full text-[11px] font-bold uppercase tracking-wider text-white"
              style="background:var(--accent)">
              {tier.badge}
            </div>
          )}
          <div class="text-xs uppercase tracking-widest font-semibold text-slate-500 mb-2">
            {tier.name}
          </div>
          <div class="flex items-baseline gap-1.5 mb-2">
            <span class="text-2xl font-bold text-slate-800">$</span>
            <span class="text-5xl font-extrabold text-slate-900 leading-none tracking-tight"
              data-onetime={formatPrice(tier.priceOnetime)}
              data-retainer={formatPrice(tier.priceRetainer)}
              style="font-family:var(--font-heading)">
              {formatPrice(tier.priceOnetime)}
            </span>
            {tier.priceSuffix && <span class="text-sm text-slate-500 ml-1">{tier.priceSuffix}</span>}
            <span class="price-original hidden text-base text-slate-400 line-through ml-2">
              ${formatPrice(tier.priceOnetime)}
            </span>
          </div>
          <div class="price-retainer-line hidden text-xs font-semibold mb-2 -mt-1" style="color:var(--accent)">
            + ${config.pricing.retainerMonthly}/mo retainer
          </div>
          <p class="text-sm text-slate-500 mb-6 leading-relaxed">{tier.description}</p>

          <div class="hosting-callout hidden flex items-start gap-2.5 rounded-xl p-3.5 mb-5 border"
            style="background:linear-gradient(135deg, rgba(59,130,246,0.08), rgba(245,158,11,0.06));border-color:rgba(59,130,246,0.2)">
            <div class="w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0"
              style="background:var(--accent)">✓</div>
            <div class="text-xs leading-snug">
              <strong class="text-slate-900 block mb-0.5">Hosting included</strong>
              <span class="text-slate-500">Managed hosting, SSL, backups & uptime monitoring — a $25/mo value, free</span>
            </div>
          </div>

          <div class="h-px bg-slate-200 mb-6"></div>
          <ul class="flex flex-col gap-3 mb-8 flex-1">
            {tier.features.map(feature => (
              <li class="flex items-start gap-2.5 text-sm leading-snug text-slate-600">
                <span class="font-bold text-base flex-shrink-0" style="color:var(--accent)">✓</span>
                {feature}
              </li>
            ))}
          </ul>
          <a
            href="#contact"
            class={`block text-center px-6 py-3.5 rounded-lg font-bold text-sm transition hover:-translate-y-0.5 ${tier.featured ? 'text-white' : 'bg-slate-100 text-slate-800 border border-slate-200 hover:bg-slate-200'}`}
            style={tier.featured ? 'background:var(--accent)' : ''}
          >
            Get Started
          </a>
        </div>
      ))}
    </div>

    <p class="text-center mt-12 text-sm text-slate-500 max-w-3xl mx-auto">
      <strong>Monthly retainer (${config.pricing.retainerMonthly}/mo)</strong> includes ongoing maintenance, security updates, content changes, and priority support — plus <strong>${config.pricing.retainerSavings} off</strong> your initial build. &nbsp;|&nbsp;
      <a href="#contact" class="font-semibold" style="color:var(--accent)">Have something custom? Let's talk →</a>
    </p>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('#retainer-toggle button');
  const amounts = document.querySelectorAll('[data-onetime]');
  const originals = document.querySelectorAll('.price-original');
  const retainerLines = document.querySelectorAll('.price-retainer-line');
  const hostingCallouts = document.querySelectorAll('.hosting-callout');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = (btn as HTMLElement).dataset.mode;
      buttons.forEach(b => {
        const isActive = b === btn;
        b.classList.toggle('text-white', isActive);
        b.classList.toggle('text-slate-500', !isActive);
        if (isActive) {
          (b as HTMLElement).style.background = 'var(--accent)';
          (b as HTMLElement).style.boxShadow = '0 4px 14px rgba(59,130,246,0.3)';
        } else {
          (b as HTMLElement).style.background = 'transparent';
          (b as HTMLElement).style.boxShadow = 'none';
        }
      });
      amounts.forEach(a => {
        const el = a as HTMLElement;
        el.textContent = mode === 'retainer' ? el.dataset.retainer! : el.dataset.onetime!;
      });
      originals.forEach(o => o.classList.toggle('hidden', mode !== 'retainer'));
      retainerLines.forEach(l => {
        l.classList.toggle('hidden', mode !== 'retainer');
        l.classList.toggle('flex', mode === 'retainer');
      });
      hostingCallouts.forEach(c => {
        c.classList.toggle('hidden', mode !== 'retainer');
        c.classList.toggle('flex', mode === 'retainer');
      });
    });
  });
</script>
