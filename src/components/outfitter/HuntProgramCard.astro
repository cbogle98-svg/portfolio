---
interface Props {
  program: any;
  slug: string;
}
const { program, slug } = Astro.props;
---

<a
  href={`/${slug}/hunts/${program.slug}/`}
  class="group flex flex-col h-full rounded-sm border overflow-hidden transition hover:-translate-y-1.5 hover:shadow-2xl"
  style="background:var(--ccv-cream);border-color:rgba(31,38,32,0.12)"
>
  {program.image ? (
    <div class="relative h-48 overflow-hidden">
      <img
        src={program.image}
        alt={program.name}
        loading="lazy"
        class="w-full h-full object-cover transition duration-500 group-hover:scale-105"
      />
      <div class="absolute inset-0 pointer-events-none" style="background:linear-gradient(180deg, transparent 55%, rgba(31,38,32,0.35) 100%)"></div>
    </div>
  ) : (
    program.icon && (
      <div class="text-5xl pt-8 px-8 md:px-10 opacity-80">{program.icon}</div>
    )
  )}

  <div class="flex flex-col flex-grow p-8 md:p-10">
    <div class="text-[10px] uppercase tracking-[0.3em] mb-3" style="color:var(--ccv-rust)">
      {program.season}
    </div>
    <h3 class="text-3xl md:text-4xl mb-4 leading-tight" style="color:var(--ccv-night)">
      {program.name}
    </h3>
    <p class="text-base leading-relaxed mb-6 flex-grow" style="color:var(--ccv-text-light)">
      {program.summary}
    </p>
    <span
      class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.15em] transition group-hover:gap-3"
      style="color:var(--ccv-rust)"
    >
      Learn More →
    </span>
  </div>
</a>
