---
import config from '../data/config.json';
// Renamed from "Hosting" to retainer value section.
// Kept the filename to avoid changing index.astro imports.
---

<section id="retainer" class="py-32 border-t border-b border-slate-200" style="background:white">
  <div class="max-w-6xl mx-auto px-7">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="text-xs uppercase tracking-[0.3em] font-medium mb-3" style="color:#78350F">
        {config.retainer.eyebrow}
      </div>
      <h2 class="text-4xl md:text-5xl font-light mb-4 leading-[1.1] tracking-tight" style="color:#1C1917">
        {config.retainer.headline1}<br />{config.retainer.headline2}
      </h2>
      <p class="text-base leading-relaxed text-slate-500">
        {config.retainer.subhead}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto mb-12">
      {config.retainer.features.map(feature => (
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 transition hover:-translate-y-1 hover:shadow-lg">
          <div class="text-3xl mb-4">{feature.icon}</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">{feature.title}</h3>
          <p class="text-sm text-slate-500 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>

    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-3 rounded-full px-6 py-3 border border-slate-200 bg-white shadow-sm mb-6">
        <span class="text-3xl font-extrabold text-slate-900" style="font-family:var(--font-heading)">$50</span>
        <span class="text-sm text-slate-500">/month — included with every project</span>
      </div>
      <p class="text-sm text-slate-500 leading-relaxed">
        {config.retainer.ownership}
      </p>
    </div>
  </div>
</section>
