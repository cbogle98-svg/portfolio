---
import config from '../data/config.json';
---

<section id="services" class="py-32" style="background:var(--cream)">
  <div class="max-w-6xl mx-auto px-7">
    <div class="text-xs uppercase tracking-[0.3em] font-medium mb-3" style="color:#78350F">
      {config.services.eyebrow}
    </div>
    <h2 class="text-4xl md:text-5xl font-semibold mb-4 leading-[1.1] tracking-tight" style="color:#1C1917">
      {config.services.headline}<br />{config.services.headline2}
    </h2>
    <p class="text-base leading-relaxed mb-16 max-w-xl text-slate-500">
      {config.services.subhead}
    </p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {config.services.items.map(service => (
        <div class="bg-white border border-slate-200 rounded-xl p-9 transition hover:-translate-y-1.5 hover:shadow-2xl hover:border-[var(--accent)] relative overflow-hidden group">
          <div class="absolute top-0 left-0 right-0 h-[3px] opacity-0 group-hover:opacity-100 transition"
            style="background:var(--accent)"></div>
          <div class="w-13 h-13 rounded-xl flex items-center justify-center mb-5"
            style="background:var(--accent-glow);width:52px;height:52px;color:var(--accent)">
            {service.icon === 'design' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/>
                <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/>
                <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>
                <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/>
                <path d="M12 2a10 10 0 0 0 0 20c1.32 0 2.4-1.09 2.4-2.4 0-.62-.24-1.18-.61-1.62a.4.4 0 0 1 .31-.65h1.92A4.98 4.98 0 0 0 21 11.4 9.99 9.99 0 0 0 12 2z"/>
              </svg>
            )}
            {service.icon === 'mobile' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
                <path d="M12 18h.01"/>
              </svg>
            )}
            {service.icon === 'seo' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
              </svg>
            )}
            {service.icon === 'hosting' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
              </svg>
            )}
            {service.icon === 'copy' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
            )}
            {service.icon === 'support' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
              </svg>
            )}
          </div>
          <h3 class="text-lg font-bold mb-2.5 text-slate-900" style="font-family:var(--font-body)">
            {service.title}
          </h3>
          <p class="text-sm leading-relaxed text-slate-500">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
