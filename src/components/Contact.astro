---
import config from '../data/config.json';
import ContactForm from './ContactForm.astro';
const phoneDigits = config.owner.phone.replace(/\D/g, '');
---

<section id="contact" class="py-32 relative overflow-hidden" style="background:var(--navy)">
  <div class="absolute inset-0 pointer-events-none"
    style="background:radial-gradient(ellipse at center, rgba(217,119,6,0.10), transparent 70%)"></div>
  <div class="max-w-6xl mx-auto px-7 relative z-10">
    <div class="grid md:grid-cols-2 gap-16 items-start">

      <div>
        <div class="text-xs uppercase tracking-[0.3em] font-medium mb-3" style="color:var(--accent-light)">
          {config.contact.eyebrow}
        </div>
        <h2 class="text-4xl md:text-5xl font-semibold mb-4 text-white leading-[1.1] tracking-tight">
          {config.contact.headline}
        </h2>
        <p class="text-lg leading-relaxed mb-10" style="color:#A8A29E">
          {config.contact.subhead}
        </p>

        <div class="space-y-6">
          <a href={`tel:${phoneDigits}`} class="block transition hover:opacity-80">
            <div class="text-xs uppercase tracking-widest mb-1" style="color:#A8A29E">Call me</div>
            <div class="text-2xl md:text-3xl font-bold" style="color:var(--accent);font-family:var(--font-heading)">
              (254) 277-2131
            </div>
          </a>

          <a href={`mailto:${config.owner.email}`} class="block transition hover:opacity-80">
            <div class="text-xs uppercase tracking-widest mb-1" style="color:#A8A29E">Email</div>
            <div class="text-base text-white/80">{config.owner.email}</div>
          </a>

          <div>
            <div class="text-xs uppercase tracking-widest mb-1" style="color:#A8A29E">Based in</div>
            <div class="text-base text-white/80">
              {config.owner.location}<br />
              Serving {config.owner.serviceArea}
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-8 md:p-10">
        <h3 class="text-xl font-bold text-white mb-2" style="font-family:var(--font-heading)">
          Send Me a Message
        </h3>
        <p class="text-sm mb-6" style="color:#A8A29E">
          Tell me about your project and I'll get back to you within 24 hours.
        </p>
        <ContactForm />
      </div>

    </div>
  </div>
</section>
