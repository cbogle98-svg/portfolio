---
import config from '../data/config.json';
---

<section id="contact" class="py-32 text-center relative overflow-hidden" style="background:var(--navy)">
  <div class="absolute inset-0 pointer-events-none"
    style="background:radial-gradient(ellipse at center, rgba(59,130,246,0.08), transparent 70%)"></div>
  <div class="max-w-2xl mx-auto px-7 relative z-10">
    <div class="text-xs uppercase tracking-[0.3em] font-bold mb-3" style="color:var(--accent-light)">
      {config.contact.eyebrow}
    </div>
    <h2 class="text-4xl md:text-5xl font-extrabold mb-4 text-white leading-[1.1] tracking-tight">
      {config.contact.headline}
    </h2>
    <p class="text-lg leading-relaxed mb-10" style="color:#94A3B8">
      {config.contact.subhead}
    </p>
    <div class="flex flex-wrap justify-center gap-4 mb-10">
      <a
        href={`mailto:${config.owner.email}`}
        class="px-8 py-4 rounded-lg font-bold text-sm text-white transition hover:-translate-y-0.5 hover:shadow-2xl"
        style="background:var(--accent)"
      >
        Email Me
      </a>
      <a
        href={`tel:${config.owner.phone}`}
        class="px-8 py-4 rounded-lg font-semibold text-sm text-white border transition hover:bg-white/5"
        style="border-color:rgba(255,255,255,0.15)"
      >
        Give Me a Call
      </a>
    </div>
    <div class="text-sm" style="color:#64748B">
      Based in {config.owner.location} — Serving {config.owner.serviceArea}
    </div>
  </div>
</section>
