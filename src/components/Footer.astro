---
import config from '../data/config.json';
const year = new Date().getFullYear();
---

<footer class="py-10 border-t" style="background:#1C1917;border-color:rgba(231,229,228,0.08)">
  <div class="max-w-6xl mx-auto px-7 flex flex-col md:flex-row items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 72" class="h-7 w-auto">
        <line x1="8" y1="56" x2="52" y2="56" stroke="#FAFAF9" stroke-width="2"/>
        <polyline points="8,56 8,22 28,38 48,22 48,56" fill="none" stroke="#FAFAF9" stroke-width="2" stroke-linejoin="round"/>
        <circle cx="28" cy="16" r="6" fill="#D97706"/>
        <text x="68" y="36" font-family="Arial, Helvetica, sans-serif" font-size="26" font-weight="300" fill="#FAFAF9" letter-spacing="1">BOSQUE</text>
        <line x1="68" y1="43" x2="310" y2="43" stroke="#D97706" stroke-width="1.25"/>
        <text x="68" y="58" font-family="Arial, Helvetica, sans-serif" font-size="12" font-weight="500" fill="#FCD34D" letter-spacing="5">WORKS</text>
      </svg>
    </div>
    <p class="text-xs" style="color:#A8A29E;letter-spacing:0.5px">
      © {year} {config.owner.businessLegalName} — {config.owner.location} — All Rights Reserved
    </p>
  </div>
</footer>
