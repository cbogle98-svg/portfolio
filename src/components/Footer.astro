---
import config from '../data/config.json';
const year = new Date().getFullYear();
---

<footer class="py-10 border-t border-white/5" style="background:#0F172A">
  <div class="max-w-6xl mx-auto px-7 flex flex-col md:flex-row items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 rounded-md flex items-center justify-center font-extrabold text-sm text-white"
        style="background:var(--accent)">
        {config.owner.initials}
      </div>
      <span class="text-sm font-semibold" style="color:#94A3B8">{config.owner.name} — Web Design</span>
    </div>
    <p class="text-xs" style="color:#64748B">
      © {year} {config.owner.name} — {config.owner.location} — All Rights Reserved
    </p>
  </div>
</footer>
