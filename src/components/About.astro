---
import config from '../data/config.json';
---

<section id="about" class="py-32" style="background:#FAFAF9">
  <div class="max-w-6xl mx-auto px-7">
    <div class="grid md:grid-cols-[1fr_1.2fr] gap-20 items-center">
      <div class="bg-white rounded-2xl p-12 relative overflow-hidden" style="border:1px solid #E7E5E4">
        <div class="absolute top-0 left-0 right-0 h-1"
          style="background:linear-gradient(90deg, var(--accent), var(--accent-light))"></div>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 72" class="h-12 w-auto mb-5">
          <line x1="8" y1="56" x2="52" y2="56" stroke="#44403C" stroke-width="2"/>
          <polyline points="8,56 8,22 28,38 48,22 48,56" fill="none" stroke="#44403C" stroke-width="2" stroke-linejoin="round"/>
          <circle cx="28" cy="16" r="6" fill="#D97706"/>
          <text x="68" y="36" font-family="Arial, Helvetica, sans-serif" font-size="26" font-weight="300" fill="#1C1917" letter-spacing="1">BOSQUE</text>
          <line x1="68" y1="43" x2="310" y2="43" stroke="#D97706" stroke-width="1.25"/>
          <text x="68" y="58" font-family="Arial, Helvetica, sans-serif" font-size="12" font-weight="500" fill="#78350F" letter-spacing="5">WORKS</text>
        </svg>
        <h3 class="text-2xl font-light mb-1" style="color:#1C1917">{config.owner.name}</h3>
        <div class="text-xs font-medium uppercase tracking-[0.25em] mb-4" style="color:#78350F">{config.owner.title}</div>
        <p class="text-base leading-relaxed" style="color:#44403C">
          {config.about.intro}
        </p>
      </div>
      <div>
        <div class="text-xs uppercase tracking-[0.3em] font-medium mb-3" style="color:#78350F">
          {config.about.eyebrow}
        </div>
        <h3 class="text-3xl md:text-4xl font-light mb-5 leading-tight" style="color:#1C1917">
          {config.about.headline}
        </h3>
        <p class="text-base leading-relaxed text-slate-500 mb-5">
          {config.about.body1}
        </p>
        <p class="text-base leading-relaxed text-slate-500 mb-7">
          {config.about.body2}
        </p>
        <div class="flex flex-wrap gap-3">
          {config.about.credentials.map(cred => (
            <div class="bg-white border border-slate-200 px-4 py-2.5 rounded-lg text-xs font-semibold text-slate-600">
              {cred}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
