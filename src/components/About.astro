---
import config from '../data/config.json';
---

<section id="about" class="py-32" style="background:#F8FAFC">
  <div class="max-w-6xl mx-auto px-7">
    <div class="grid md:grid-cols-[1fr_1.2fr] gap-20 items-center">
      <div class="bg-white border border-slate-200 rounded-2xl p-12 relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1"
          style="background:linear-gradient(90deg, var(--accent), var(--warm))"></div>
        <div class="w-20 h-20 rounded-2xl flex items-center justify-center text-3xl font-extrabold text-white mb-5"
          style="background:var(--navy);font-family:var(--font-heading)">
          {config.owner.initials}
        </div>
        <h3 class="text-2xl font-extrabold text-slate-900 mb-1">{config.owner.name}</h3>
        <div class="text-sm font-semibold mb-4" style="color:var(--accent)">{config.owner.title}</div>
        <p class="text-base leading-relaxed text-slate-500">
          {config.about.intro}
        </p>
      </div>
      <div>
        <div class="text-xs uppercase tracking-[0.3em] font-bold mb-3" style="color:var(--accent)">
          {config.about.eyebrow}
        </div>
        <h3 class="text-3xl md:text-4xl font-extrabold mb-5 text-slate-900 leading-tight">
          {config.about.headline}
        </h3>
        <p class="text-base leading-relaxed text-slate-500 mb-5">
          {config.about.body1}
        </p>
        <p class="text-base leading-relaxed text-slate-500 mb-7">
          {config.about.body2}
        </p>
        <div class="flex flex-wrap gap-3">
          {config.about.credentials.map(cred => (
            <div class="bg-white border border-slate-200 px-4 py-2.5 rounded-lg text-xs font-semibold text-slate-600">
              {cred}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
