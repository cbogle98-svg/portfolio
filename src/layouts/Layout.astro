---
import '../styles/global.css';
import config from '../data/config.json';

interface Props {
  title?: string;
  description?: string;
  /** Override OG image — defaults to the site logo. Should be an absolute URL. */
  ogImage?: string;
  /** Schema.org type override — defaults to no per-page schema; the Layout always emits ProfessionalService for the site. */
  schemaType?: 'WebPage' | 'Article' | 'AboutPage' | 'ContactPage';
}

const { title, description, ogImage, schemaType } = Astro.props;

const SITE_URL = 'https://bosqueworks.com';
const pageTitle = title ?? `${config.owner.name} — ${config.owner.title} — ${config.owner.location}`;
const pageDesc = description ?? `${config.owner.tagline}. Based in ${config.owner.location}, serving ${config.owner.serviceArea}.`;

// Canonical URL — strip trailing slash to keep consistent (Astro emits /foo/ by default but we canonical to /foo)
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = `${SITE_URL}${pathname === '/' ? '/' : pathname}`;

const ogImageUrl = ogImage ?? `${SITE_URL}/brand/logo-horizontal-light.svg`;

// Schema.org: site-wide ProfessionalService block. Search engines build a knowledge graph
// from this — especially valuable for local services (rich snippets, GBP linkage, etc.).
const professionalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE_URL}/#business`,
  name: config.owner.businessName,
  alternateName: config.owner.businessLegalName,
  description: pageDesc,
  url: SITE_URL,
  telephone: config.owner.phone,
  email: config.owner.email,
  image: `${SITE_URL}/brand/logo-horizontal-light.svg`,
  logo: `${SITE_URL}/brand/logo-horizontal-light.svg`,
  priceRange: '$200-$750 + $50/mo retainer',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Stephenville',
    addressRegion: 'TX',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Erath County, TX' },
    { '@type': 'AdministrativeArea', name: 'Hood County, TX' },
    { '@type': 'AdministrativeArea', name: 'Comanche County, TX' },
    { '@type': 'AdministrativeArea', name: 'Eastland County, TX' },
    { '@type': 'AdministrativeArea', name: 'Somervell County, TX' },
    { '@type': 'AdministrativeArea', name: 'Palo Pinto County, TX' },
  ],
  founder: {
    '@type': 'Person',
    name: config.owner.name,
    jobTitle: config.owner.title,
    url: SITE_URL,
  },
  serviceType: [
    'Custom web design',
    'Mobile-first development',
    'Local SEO',
    'Managed hosting',
    'Content writing',
    'Google Business Profile setup',
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '17:00',
  },
  sameAs: [], // Add social URLs here as they exist
};

const webPageSchema = schemaType
  ? {
      '@context': 'https://schema.org',
      '@type': schemaType,
      name: pageTitle,
      description: pageDesc,
      url: canonicalUrl,
      isPartOf: { '@id': `${SITE_URL}/#business` },
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.owner.businessName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Icons + fonts -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Schema.org structured data (LocalBusiness/ProfessionalService) -->
    <script type="application/ld+json" set:html={JSON.stringify(professionalServiceSchema)} />
    {webPageSchema && <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />}

    <style is:global define:vars={{
      navy: config.brand.navy,
      navyLight: config.brand.navyLight,
      navyMid: config.brand.navyMid,
      accent: config.brand.accent,
      accentLight: config.brand.accentLight,
      warm: config.brand.warm,
      cream: config.brand.cream,
      border: config.brand.border,
      muted: config.brand.muted,
      amberBg: config.brand.amberBg
    }}>
      :root {
        --navy: var(--navy);
        --navy-light: var(--navyLight);
        --navy-mid: var(--navyMid);
        --accent: var(--accent);
        --accent-light: var(--accentLight);
        --warm: var(--warm);
        --cream: var(--cream);
        --border: var(--border);
        --muted: var(--muted);
        --amber-bg: var(--amberBg);
        --accent-glow: color-mix(in srgb, var(--accent) 15%, transparent);
        --font-heading: 'Inter', Arial, Helvetica, sans-serif;
        --font-body: Arial, Helvetica, sans-serif;
      }
      @layer base {
        body {
          background: var(--cream);
          color: #44403C;
          font-family: var(--font-body);
          font-weight: 400;
        }
        h1, h2, h3, h4, h5, h6 {
          font-family: var(--font-heading);
          font-weight: 300;
          color: #1C1917;
          letter-spacing: 0.01em;
        }
      }
      .eyebrow {
        font-weight: 500;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 4px;
        color: #78350F;
      }
      html { scroll-behavior: smooth; }
    </style>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
